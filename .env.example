# Copiá este archivo como .env.local y completá los valores reales.
# Los mismos nombres se cargan en Vercel (Project Settings > Environment Variables).
# Mientras las dos variables VITE_ estén vacías, la web funciona en MODO DE PRUEBA:
# tienda y panel usan una base de prueba en el navegador y el checkout no cobra.
# Después de completarlas, `npm run check` revisa que todo esté bien conectado.

# ----- Supabase (Project Settings > API Keys) -----
# Estas dos se usan en el navegador: son públicas por diseño.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Esta es secreta: solo para las funciones de /api. Nunca con prefijo VITE_.
SUPABASE_SECRET_KEY=

# ----- Mercado Pago (Tus integraciones > Credenciales) -----
# Para probar, usá el Access Token de PRUEBA (empieza con TEST-).
MP_ACCESS_TOKEN=
# Clave secreta de Webhooks (Tus integraciones > Webhooks). Valida que el aviso venga de Mercado Pago.
MP_WEBHOOK_SECRET=

# ----- Sitio -----
# URL pública, sin barra final. Se usa para volver de Mercado Pago y para el webhook.
SITE_URL=https://ejemplo.vercel.app

# ----- Emails (opcional, Resend) -----
# Si RESEND_API_KEY queda vacío, no se envían emails y el resto funciona igual.
RESEND_API_KEY=
EMAIL_FROM=Giorgio Perfumería <pedidos@ejemplo.com>
# A dónde llega el aviso de cada pedido nuevo
SHOP_EMAIL=
